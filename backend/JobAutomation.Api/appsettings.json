{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "JobAutomation",
    "Audience": "JobAutomation",
    "ExpirationMinutes": 60
  },
  "Hangfire": {
    "WorkerCount": 1
  },
  "HttpJobExecutor": {
    "MaxResponseBodyBytes": 1048576,
    "MaxRedirects": 3
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60,
    "RunPermitLimit": 30,
    "RunWindowSeconds": 60,
    "RetryPermitLimit": 20,
    "RetryWindowSeconds": 60
  },
  "Observability": {
    "WorkerHeartbeatIntervalSeconds": 20,
    "WorkerStaleThresholdSeconds": 60,
    "OutboxPendingDegradedThreshold": 100,
    "OutboxPendingUnhealthyThreshold": 500,
    "OutboxOldestPendingDegradedMinutes": 5,
    "OutboxOldestPendingUnhealthyMinutes": 30
  }
}
