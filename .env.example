# PostgreSQL (Docker Compose)
POSTGRES_DB=jobautomation
POSTGRES_USER=jobautomation
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_PORT=5433

# Backend database connection (host -> Docker mapped port)
DATABASE_CONNECTION_STRING=Host=127.0.0.1;Port=5433;Database=jobautomation;Username=jobautomation;Password=change_me_in_local_env

# JWT Authentication
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
JWT_ISSUER=JobAutomation
JWT_AUDUENCE=JobAutomation
JWT_EXPIRATION_MINUTES=60

# CORS (comma-separated origins for production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate limiting
RATE_LIMITING__AUTHPERMITLIMIT=10
RATE_LIMITING__AUTHWINDOWSECONDS=60
RATE_LIMITING__RUNPERMITLIMIT=30
RATE_LIMITING__RUNWINDOWSECONDS=60
RATE_LIMITING__RETRYPERMITLIMIT=20
RATE_LIMITING__RETRYWINDOWSECONDS=60

# Observability thresholds
OBSERVABILITY__WORKERHEARTBEATINTERVALSECONDS=20
OBSERVABILITY__WORKERSTALETHRESHOLDSECONDS=60
OBSERVABILITY__OUTBOXPENDINGDEGRADEDTHRESHOLD=100
OBSERVABILITY__OUTBOXPENDINGUNHEALTHYTHRESHOLD=500
OBSERVABILITY__OUTBOXOLDESTPENDINGDEGRADEDMINUTES=5
OBSERVABILITY__OUTBOXOLDESTPENDINGUNHEALTHYMINUTES=30

# Docker Compose service ports
API_PORT=8080
FRONTEND_PORT=3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
